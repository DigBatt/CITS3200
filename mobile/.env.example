# Copy to .env and edit. Restart `npx expo start` after changing.

# Where the Flask backend is. Leave unset to use the Metro dev server's host
# on port 5000, which works when the backend runs on the same machine as
# `npx expo start` and the phone is on the same network.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5000

# Flask port used when EXPO_PUBLIC_API_URL is unset.
# EXPO_PUBLIC_API_PORT=5000

# How often the app re-fetches vehicle positions.
# EXPO_PUBLIC_REFRESH_SECONDS=10
