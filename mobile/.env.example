# Copy to .env and edit. Restart `npx expo start` after changing.
# Normally nothing here is needed: endpoints.yaml holds the LAN port and the
# tunnel URLs. These override it.

# Point the app anywhere at all, ignoring endpoints.yaml.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:5001

# Backend port on the Metro host, instead of lan.port in endpoints.yaml.
# EXPO_PUBLIC_API_PORT=5001

# How often the app re-fetches vehicle positions.
# EXPO_PUBLIC_REFRESH_SECONDS=10
